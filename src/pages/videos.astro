---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Videos | DACA">
  <main class="videos-page">
    <p class="section-label">Videos</p>

    <h1>Visual Stories</h1>

    <p class="intro">
      Music videos, field recordings, creative experiments,
      and visual journeys will appear here.
    </p>

    <div class="placeholder">
      First video releases coming soon.
    </div>
  </main>

  <style>
    .videos-page {
      max-width: 900px;
      margin: 0 auto;
      padding: 160px 24px;
    }

    .section-label {
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #d8b98a;
      font-size: 14px;
    }

    h1 {
      font-size: 90px;
      margin: 20px 0;
    }

    .intro {
      font-size: 28px;
      margin-bottom: 60px;
    }

    .placeholder {
      border: 1px solid rgba(255,255,255,.15);
      padding: 120px 40px;
      text-align: center;
      font-size: 24px;
    }
  </style>
</Layout>