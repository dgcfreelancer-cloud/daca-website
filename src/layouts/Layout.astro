---
const { title = "DACA | Alternative Music Artist" } = Astro.props;
---

<html lang="en">
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body>
    <header>
      <nav>
        <a class="logo" href="/">DACA</a>
        <div class="nav-links">
          <a href="/about">About</a>
          <a href="/music">Music</a>
          <a href="/videos">Videos</a>
          <a href="/gallery">Gallery</a>
          <a href="/contact">Contact</a>
        </div>
      </nav>
    </header>

    <slot />

    <footer>
    <div class="social-links">
      <a href="#" aria-label="Instagram">📷</a>
     <a href="#" aria-label="TikTok">🎬</a>
      <a href="#" aria-label="Spotify">🎵</a>
      <a href="#" aria-label="YouTube">▶️</a>
      <a href="#" aria-label="Bandcamp">🎧</a>
    </div>

      <p>© 2026 DACA</p>
    </footer>
  </body>

  <style>
    body {
      margin: 0;
      font-family: Georgia, serif;
      background: #0f120f;
      color: #f4efe7;
    }

    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 10;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;

      padding: 24px 48px;
      background: rgba(5, 8, 7, 0.55);
      backdrop-filter: blur(8px);
    }

    .logo {
      font-size: 22px;
      color: #f4efe7;
      text-decoration: none;
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      gap: 24px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .nav-links a {
      color: #f4efe7;
      text-decoration: none;
      font-size: 18px;
      white-space: nowrap;
    }

    footer {
      padding: 40px 48px;
      color: #b8ada0;
    }

    a {
      color: #d8b98a;
    }

    @media (max-width: 700px) {
      nav {
        align-items: flex-start;
        padding: 16px 20px;
        gap: 12px;
      }

      .logo {
        font-size: 18px;
      }

      .nav-links {
        gap: 12px;
        justify-content: flex-end;
      }

      .nav-links a {
        font-size: 15px;
      }

      footer {
        padding: 32px 24px;
      }
    }

    @media (max-width: 430px) {
      nav {
        display: block;
      }

      .logo {
        display: block;
        margin-bottom: 10px;
      }

      .nav-links {
        justify-content: flex-start;
        gap: 10px 14px;
      }

      .nav-links a {
        font-size: 15px;
      }
    }

    .social-links {
  display: flex;
  justify-content: center;
  gap: 24px;
  margin-bottom: 20px;
}

.social-links a {
  font-size: 28px;
  text-decoration: none;
  color: #f5f1ea;
  transition: opacity 0.3s ease;
}

.social-links a:hover {
  opacity: 0.7;
}
  </style>
</html>